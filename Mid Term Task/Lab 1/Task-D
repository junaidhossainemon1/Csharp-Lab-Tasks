using System;

class TaskD
{
    static void Main()
    {
        Console.Write("Enter N: ");
        int n = Convert.ToInt32(Console.ReadLine());
        
        int sum = 0;
        int i = 1;

        while (i <= n)
        {
            sum = sum + i;
            i++;
        }

        Console.WriteLine("Sum of numbers from 1 to " + n + ": " + sum);
    }
}
